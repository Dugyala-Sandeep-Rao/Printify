# Copy these values into Windows environment variables for a real shop.
# Do not commit real secrets.
PRINTIFY_ADMIN_TOKEN=replace-with-a-long-random-token
PRINTIFY_UPI_ID=
PRINTIFY_UPI_NAME=Printify
PRINTIFY_PRINTER=
PRINTIFY_RAZORPAY_KEY_ID=
PRINTIFY_RAZORPAY_KEY_SECRET=
PRINTIFY_MAX_UPLOAD_MB=50
PRINTIFY_KEEP_DAYS=7
